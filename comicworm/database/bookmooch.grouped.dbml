// Scope: Nhom8_ChucNang.docx. Generated by build_schema.py.
Project comicworm_functions {
  database_type: 'MySQL'
  Note: 'Database phục vụ 25 chức năng trong Nhom8_ChucNang.docx. SQL: schema.sql. ON UPDATE CURRENT_TIMESTAMP ghi trong note. AI thực hiện tại backend, database lưu dữ liệu đầu vào/kết quả.'
}

// tg_auth
Table users {
  id bigint [pk, increment, not null]
  email varchar(150) [unique, not null]
  password_hash varchar(255)
  google_sub varchar(255) [unique]
  full_name varchar(100) [not null]
  phone varchar(20)
  avatar_url text
  role varchar(20) [not null, default: 'USER', check: `role IN ('USER', 'ADMIN')`]
  is_seller boolean [not null, default: false]
  account_status varchar(20) [not null, default: 'ACTIVE', check: `account_status IN ('ACTIVE', 'LOCKED')`]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'SQL: ON UPDATE CURRENT_TIMESTAMP']
  deleted_at datetime
  checks {
    `password_hash IS NOT NULL OR google_sub IS NOT NULL` [name: 'ck_user_login_identity']
  }
}

Table auth_sessions {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  token_hash char(64) [unique, not null]
  expires_at datetime [not null]
  revoked_at datetime
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, expires_at) [name: 'idx_session_user_expiry']
  }
}

Table password_reset_tokens {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  token_hash char(64) [unique, not null]
  expires_at datetime [not null]
  used_at datetime
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

// tg_catalog
Table categories {
  id int [pk, increment, not null]
  name varchar(100) [not null]
  slug varchar(120) [unique, not null]
  parent_id int
}

Table authors {
  id int [pk, increment, not null]
  name varchar(150) [not null]
}

Table publishers {
  id int [pk, increment, not null]
  name varchar(150) [not null]
  slug varchar(160) [unique, not null]
}

Table products {
  id bigint [pk, increment, not null]
  seller_id bigint [not null]
  title varchar(255) [not null]
  slug varchar(255) [unique, not null]
  description text [not null]
  cover_image_url text
  category_id int [not null]
  author_id int
  publisher_id int
  volume_numbers varchar(100)
  edition_type varchar(50)
  publication_year int
  condition_percent int [not null, check: `condition_percent BETWEEN 0 AND 100`]
  price decimal(15,2) [not null, check: `price >= 0`]
  stock_quantity int [not null, default: 1, check: `stock_quantity >= 0`]
  listing_type varchar(20) [not null, default: 'SELL', check: `listing_type IN ('SELL', 'TRADE', 'SELL_AND_TRADE')`]
  trade_wish_note text
  is_active boolean [not null, default: true]
  moderation_status varchar(20) [not null, default: 'PENDING', check: `moderation_status IN ('PENDING', 'APPROVED', 'REJECTED')`]
  moderated_by bigint
  moderation_reason text
  moderated_at datetime
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'SQL: ON UPDATE CURRENT_TIMESTAMP']
  deleted_at datetime
  indexes {
    (id, seller_id) [unique, name: 'uq_product_owner']
    (moderation_status, is_active, created_at) [name: 'idx_product_latest']
    (category_id, price) [name: 'idx_product_filter']
    (seller_id, created_at) [name: 'idx_seller_products']
  }
}

Table product_images {
  id bigint [pk, increment, not null]
  product_id bigint [not null]
  image_url text [not null]
  image_type varchar(10) [not null, default: 'DETAIL', check: `image_type IN ('COVER', 'DETAIL')`]
  display_order int [not null, default: 0, check: `display_order >= 0`]
  indexes {
    (product_id, display_order) [unique, name: 'uq_product_image_order']
  }
  Note: 'image_type=COVER là ảnh bìa, DETAIL là ảnh chi tiết. URL ảnh bìa đồng bộ với products.cover_image_url. Một ảnh/một vị trí trong sản phẩm.'
}

// tg_orders_payments
Table carts {
  id bigint [pk, increment, not null]
  user_id bigint [unique, not null]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'SQL: ON UPDATE CURRENT_TIMESTAMP']
}

Table cart_items {
  id bigint [pk, increment, not null]
  cart_id bigint [not null]
  product_id bigint [not null]
  quantity int [not null, default: 1, check: `quantity > 0`]
  is_selected boolean [not null, default: true]
  indexes {
    (cart_id, product_id) [unique, name: 'uq_cart_product']
  }
}

Table checkout_batches {
  id bigint [pk, increment, not null]
  checkout_code varchar(60) [unique, not null]
  buyer_id bigint [not null]
  idempotency_key varchar(100) [unique, not null]
  total_amount decimal(15,2) [not null, check: `total_amount >= 0`]
  expires_at datetime [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table orders {
  id bigint [pk, increment, not null]
  order_code varchar(60) [unique, not null]
  checkout_id bigint [not null]
  buyer_id bigint [not null]
  seller_id bigint [not null]
  subtotal_amount decimal(15,2) [not null, check: `subtotal_amount >= 0`]
  shipping_fee decimal(15,2) [not null, default: 0, check: `shipping_fee >= 0`]
  total_amount decimal(15,2) [not null, check: `total_amount >= 0`]
  recipient_name varchar(100) [not null]
  recipient_phone varchar(20) [not null]
  shipping_address text [not null]
  buyer_note text
  status varchar(25) [not null, default: 'WAITING_PAYMENT', check: `status IN ('WAITING_PAYMENT', 'WAITING_CONFIRM', 'PACKING', 'SHIPPING', 'DELIVERED', 'COMPLETED', 'CANCELLED')`]
  payment_status varchar(25) [not null, default: 'PENDING', check: `payment_status IN ('PENDING', 'PAID', 'PARTIALLY_REFUNDED', 'REFUNDED')`]
  cancelled_by bigint
  cancel_reason text
  cancelled_at datetime
  stock_released_at datetime
  completed_at datetime
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'SQL: ON UPDATE CURRENT_TIMESTAMP']
  indexes {
    (buyer_id, created_at) [name: 'idx_buyer_history']
    (seller_id, status, created_at) [name: 'idx_seller_orders']
    (status, completed_at) [name: 'idx_order_reports']
  }
  checks {
    `total_amount = subtotal_amount + shipping_fee` [name: 'ck_order_total']
  }
}

Table order_items {
  id bigint [pk, increment, not null]
  order_id bigint [not null]
  product_id bigint [not null]
  product_title varchar(255) [not null]
  image_url text
  condition_percent int [not null, check: `condition_percent BETWEEN 0 AND 100`]
  unit_price decimal(15,2) [not null, check: `unit_price >= 0`]
  quantity int [not null, check: `quantity > 0`]
  indexes {
    (order_id, product_id) [unique, name: 'uq_order_product']
  }
}

Table order_status_history {
  id bigint [pk, increment, not null]
  order_id bigint [not null]
  previous_status varchar(25)
  new_status varchar(25) [not null]
  changed_by bigint
  note text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table payments {
  id bigint [pk, increment, not null]
  payment_code varchar(60) [unique, not null]
  checkout_id bigint [not null]
  method varchar(20) [not null, check: `method IN ('VNPAY', 'MOMO', 'VIETQR', 'CREDIT_CARD')`]
  amount decimal(15,2) [not null, check: `amount > 0`]
  status varchar(20) [not null, default: 'PENDING', check: `status IN ('PENDING', 'SUCCEEDED', 'FAILED', 'EXPIRED', 'CANCELLED')`]
  provider_transaction_id varchar(150)
  idempotency_key varchar(100) [unique, not null]
  paid_at datetime
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (method, provider_transaction_id) [unique, name: 'uq_payment_provider']
  }
}

Table payment_allocations {
  payment_id bigint [not null]
  order_id bigint [not null]
  amount decimal(15,2) [not null, check: `amount > 0`]
  indexes {
    (payment_id, order_id) [pk]
  }
}

Table payment_events {
  id bigint [pk, increment, not null]
  payment_id bigint [not null]
  provider_event_id varchar(150) [not null]
  event_type varchar(50) [not null]
  signature_verified boolean [not null, default: false]
  processed_at datetime
  received_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (payment_id, provider_event_id) [unique, name: 'uq_payment_event']
  }
}

Table refunds {
  id bigint [pk, increment, not null]
  refund_code varchar(60) [unique, not null]
  payment_id bigint [not null]
  order_id bigint [not null]
  amount decimal(15,2) [not null, check: `amount > 0`]
  status varchar(20) [not null, default: 'PENDING', check: `status IN ('PENDING', 'PROCESSING', 'SUCCEEDED', 'FAILED')`]
  idempotency_key varchar(100) [unique, not null]
  provider_refund_id varchar(150) [unique]
  failure_reason text
  completed_at datetime
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  Note: 'Hoàn về giao dịch thanh toán gốc khi hủy đơn. Không có ví nội bộ hoặc yêu cầu rút tiền.'
}

// tg_reviews_points
Table reviews {
  id bigint [pk, increment, not null]
  order_item_id bigint [unique, not null]
  buyer_id bigint [not null]
  rating int [not null, check: `rating BETWEEN 1 AND 5`]
  content text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'SQL: ON UPDATE CURRENT_TIMESTAMP']
}

Table review_replies {
  id bigint [pk, increment, not null]
  review_id bigint [unique, not null]
  seller_id bigint [not null]
  content text [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'SQL: ON UPDATE CURRENT_TIMESTAMP']
}

Table loyalty_accounts {
  user_id bigint [pk, not null]
  points_balance bigint [not null, default: 0, check: `points_balance >= 0`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'SQL: ON UPDATE CURRENT_TIMESTAMP']
}

Table loyalty_transactions {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  order_id bigint [not null]
  transaction_type varchar(20) [not null, check: `transaction_type IN ('EARN', 'REVERSAL')`]
  points_delta bigint [not null, check: `points_delta <> 0`]
  balance_after bigint [not null, check: `balance_after >= 0`]
  idempotency_key varchar(100) [unique, not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  checks {
    `(transaction_type = 'EARN' AND points_delta > 0) OR (transaction_type = 'REVERSAL' AND points_delta < 0)` [name: 'ck_loyalty_sign']
  }
}

// tg_exchange
Table exchange_rooms {
  id bigint [pk, increment, not null]
  room_code varchar(60) [unique, not null]
  host_id bigint [not null]
  target_product_id bigint [not null]
  selected_offer_id bigint [unique]
  status varchar(20) [not null, default: 'OPEN', check: `status IN ('OPEN', 'AGREED', 'COMPLETED', 'CANCELLED')`]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  closed_at datetime
  indexes {
    (selected_offer_id, id) [unique, name: 'uq_room_selected_offer']
  }
}

Table exchange_room_members {
  room_id bigint [not null]
  user_id bigint [not null]
  joined_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (room_id, user_id) [pk]
  }
}

Table exchange_offers {
  id bigint [pk, increment, not null]
  room_id bigint [not null]
  buyer_id bigint [not null]
  cash_compensation decimal(15,2) [not null, default: 0, check: `cash_compensation >= 0`]
  compensation_payer_id bigint
  note text
  status varchar(20) [not null, default: 'PENDING', check: `status IN ('PENDING', 'ACCEPTED', 'DECLINED', 'WITHDRAWN')`]
  buyer_confirmed boolean [not null, default: false]
  host_confirmed boolean [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  responded_at datetime
  indexes {
    (id, room_id) [unique, name: 'uq_offer_room']
  }
  checks {
    `(cash_compensation = 0 AND compensation_payer_id IS NULL) OR (cash_compensation > 0 AND compensation_payer_id IS NOT NULL)` [name: 'ck_offer_compensation']
  }
}

Table exchange_offer_items {
  id bigint [pk, increment, not null]
  offer_id bigint [not null]
  product_id bigint [not null]
  owner_id bigint [not null]
  quantity int [not null, check: `quantity > 0`]
  title_snapshot varchar(255) [not null]
  condition_snapshot int [not null, check: `condition_snapshot BETWEEN 0 AND 100`]
  indexes {
    (offer_id, product_id) [unique, name: 'uq_offer_product']
  }
}

Table exchange_messages {
  id bigint [pk, increment, not null]
  room_id bigint [not null]
  sender_id bigint [not null]
  content text
  image_url text
  client_message_key varchar(100) [unique]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (room_id, id) [name: 'idx_exchange_chat']
  }
  checks {
    `content IS NOT NULL OR image_url IS NOT NULL` [name: 'ck_exchange_message_content']
  }
}

// tg_ai
Table product_image_features {
  image_id bigint [pk, not null]
  embedding json [not null]
  model_name varchar(100) [not null]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'SQL: ON UPDATE CURRENT_TIMESTAMP']
  checks {
    `JSON_TYPE(embedding) = 'ARRAY' AND JSON_LENGTH(embedding) > 0` [name: 'ck_image_embedding']
  }
  Note: 'Tìm bằng ảnh: backend tạo embedding cho ảnh truy vấn và so độ tương đồng với ảnh sản phẩm. MySQL 8 lưu JSON; không có vector index tự động.'
}

Table product_classifications {
  product_id bigint [pk, not null]
  status varchar(20) [not null, default: 'PENDING', check: `status IN ('PENDING', 'SUCCEEDED', 'FAILED')`]
  is_comic boolean
  confidence decimal(5,4) [check: `confidence BETWEEN 0 AND 1`]
  model_name varchar(100)
  classified_at datetime
  error_message text
  checks {
    `status <> 'SUCCEEDED' OR (is_comic IS NOT NULL AND confidence IS NOT NULL AND model_name IS NOT NULL AND classified_at IS NOT NULL)` [name: 'ck_classification_result']
  }
}

Table consultation_sessions {
  id bigint [pk, increment, not null]
  user_id bigint
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table consultation_messages {
  id bigint [pk, increment, not null]
  session_id bigint [not null]
  sender_type varchar(20) [not null, check: `sender_type IN ('USER', 'ASSISTANT')`]
  content text [not null]
  suggested_product_ids json
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (session_id, id) [name: 'idx_consultation_chat']
  }
}

// tg_notifications
Table notifications {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  order_id bigint [not null]
  title varchar(200) [not null]
  content text [not null]
  deduplication_key varchar(150) [unique, not null]
  read_at datetime
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  Note: 'Phục vụ thông báo hủy đơn, trạng thái và hoàn tiền. Không phải hệ thống ticket/CSKH.'
}

Ref fk_auth_sessions_user_id: auth_sessions.user_id > users.id [delete: restrict, update: restrict]
Ref fk_password_reset_tokens_user_id: password_reset_tokens.user_id > users.id [delete: restrict, update: restrict]
Ref fk_categories_parent_id: categories.parent_id >? categories.id [delete: restrict, update: restrict]
Ref fk_products_seller_id: products.seller_id > users.id [delete: restrict, update: restrict]
Ref fk_products_category_id: products.category_id > categories.id [delete: restrict, update: restrict]
Ref fk_products_author_id: products.author_id >? authors.id [delete: restrict, update: restrict]
Ref fk_products_publisher_id: products.publisher_id >? publishers.id [delete: restrict, update: restrict]
Ref fk_products_moderated_by: products.moderated_by >? users.id [delete: restrict, update: restrict]
Ref fk_product_images_product_id: product_images.product_id > products.id [delete: restrict, update: restrict]
Ref fk_carts_user_id: users.id - carts.user_id [delete: restrict, update: restrict]
Ref fk_cart_items_cart_id: cart_items.cart_id > carts.id [delete: restrict, update: restrict]
Ref fk_cart_items_product_id: cart_items.product_id > products.id [delete: restrict, update: restrict]
Ref fk_checkout_batches_buyer_id: checkout_batches.buyer_id > users.id [delete: restrict, update: restrict]
Ref fk_orders_checkout_id: orders.checkout_id > checkout_batches.id [delete: restrict, update: restrict]
Ref fk_orders_buyer_id: orders.buyer_id > users.id [delete: restrict, update: restrict]
Ref fk_orders_seller_id: orders.seller_id > users.id [delete: restrict, update: restrict]
Ref fk_orders_cancelled_by: orders.cancelled_by >? users.id [delete: restrict, update: restrict]
Ref fk_order_items_order_id: order_items.order_id > orders.id [delete: restrict, update: restrict]
Ref fk_order_items_product_id: order_items.product_id > products.id [delete: restrict, update: restrict]
Ref fk_order_status_history_order_id: order_status_history.order_id > orders.id [delete: restrict, update: restrict]
Ref fk_order_status_history_changed_by: order_status_history.changed_by >? users.id [delete: restrict, update: restrict]
Ref fk_payments_checkout_id: payments.checkout_id > checkout_batches.id [delete: restrict, update: restrict]
Ref fk_payment_allocations_payment_id: payment_allocations.payment_id > payments.id [delete: restrict, update: restrict]
Ref fk_payment_allocations_order_id: payment_allocations.order_id > orders.id [delete: restrict, update: restrict]
Ref fk_payment_events_payment_id: payment_events.payment_id > payments.id [delete: restrict, update: restrict]
Ref fk_refund_paid_order: refunds.(payment_id, order_id) > payment_allocations.(payment_id, order_id) [delete: restrict, update: restrict]
Ref fk_reviews_order_item_id: order_items.id - reviews.order_item_id [delete: restrict, update: restrict]
Ref fk_reviews_buyer_id: reviews.buyer_id > users.id [delete: restrict, update: restrict]
Ref fk_review_replies_review_id: reviews.id - review_replies.review_id [delete: restrict, update: restrict]
Ref fk_review_replies_seller_id: review_replies.seller_id > users.id [delete: restrict, update: restrict]
Ref fk_loyalty_accounts_user_id: users.id - loyalty_accounts.user_id [delete: restrict, update: restrict]
Ref fk_loyalty_transactions_user_id: loyalty_transactions.user_id > loyalty_accounts.user_id [delete: restrict, update: restrict]
Ref fk_loyalty_transactions_order_id: loyalty_transactions.order_id > orders.id [delete: restrict, update: restrict]
Ref fk_exchange_rooms_host_id: exchange_rooms.host_id > users.id [delete: restrict, update: restrict]
Ref fk_room_product_owner: exchange_rooms.(target_product_id, host_id) > products.(id, seller_id) [delete: restrict, update: restrict]
Ref fk_exchange_room_members_room_id: exchange_room_members.room_id > exchange_rooms.id [delete: restrict, update: restrict]
Ref fk_exchange_room_members_user_id: exchange_room_members.user_id > users.id [delete: restrict, update: restrict]
Ref fk_offer_room_member: exchange_offers.(room_id, buyer_id) > exchange_room_members.(room_id, user_id) [delete: restrict, update: restrict]
Ref fk_exchange_offers_compensation_payer_id: exchange_offers.compensation_payer_id >? users.id [delete: restrict, update: restrict]
Ref fk_room_selected_offer: exchange_offers.(id, room_id) ?- exchange_rooms.(selected_offer_id, id) [delete: restrict, update: restrict]
Ref fk_exchange_offer_items_offer_id: exchange_offer_items.offer_id > exchange_offers.id [delete: restrict, update: restrict]
Ref fk_offer_product_owner: exchange_offer_items.(product_id, owner_id) > products.(id, seller_id) [delete: restrict, update: restrict]
Ref fk_message_room_member: exchange_messages.(room_id, sender_id) > exchange_room_members.(room_id, user_id) [delete: restrict, update: restrict]
Ref fk_product_image_features_image_id: product_images.id - product_image_features.image_id [delete: restrict, update: restrict]
Ref fk_product_classifications_product_id: products.id - product_classifications.product_id [delete: restrict, update: restrict]
Ref fk_consultation_sessions_user_id: consultation_sessions.user_id >? users.id [delete: restrict, update: restrict]
Ref fk_consultation_messages_session_id: consultation_messages.session_id > consultation_sessions.id [delete: restrict, update: restrict]
Ref fk_notifications_user_id: notifications.user_id > users.id [delete: restrict, update: restrict]
Ref fk_notifications_order_id: notifications.order_id > orders.id [delete: restrict, update: restrict]

TableGroup tg_auth [color: #2563EB] {
  users
  auth_sessions
  password_reset_tokens
}

TableGroup tg_catalog [color: #059669] {
  categories
  authors
  publishers
  products
  product_images
}

TableGroup tg_orders_payments [color: #EA580C] {
  carts
  cart_items
  checkout_batches
  orders
  order_items
  order_status_history
  payments
  payment_allocations
  payment_events
  refunds
}

TableGroup tg_reviews_points [color: #CA8A04] {
  reviews
  review_replies
  loyalty_accounts
  loyalty_transactions
}

TableGroup tg_exchange [color: #9333EA] {
  exchange_rooms
  exchange_room_members
  exchange_offers
  exchange_offer_items
  exchange_messages
}

TableGroup tg_ai [color: #0891B2] {
  product_image_features
  product_classifications
  consultation_sessions
  consultation_messages
}

TableGroup tg_notifications [color: #DB2777] {
  notifications
}
